# Site configuration, one file for the Python tools AND the Slurm scripts.
#   cp site.env.example site.env   # edit, then:  source site.env
# Everything is a plain shell variable; the Python side reads the CAMPAIGN_* / JOBFLOW_* ones
# (see gpu4pyscf_campaign/settings.py). Values below are for NREL Kestrel (H100 nodes).

# --- environment ---------------------------------------------------------------------
export CAMPAIGN_REPO=/projects/<allocation>/$USER/gpu4pyscf-campaign   # this checkout
export CONDA_MODULE=conda                 # `module load $CONDA_MODULE` (Kestrel: conda or mamba)
export CONDA_ENV=qcflow                   # conda env built by setup_env.sh
export QCFLOW_GPU4PYSCF_ROOT=/projects/<allocation>/$USER/qcflow-gpu4pyscf   # crn_utils checkout

# --- FireWorks / jobflow -------------------------------------------------------------
export CAMPAIGN_LAUNCHPAD=$HOME/fw_config/my_launchpad.yaml
export JOBFLOW_CONFIG_FILE=$HOME/fw_config/jobflow_campaign.yaml
export FW_CONFIG_FILE=$HOME/fw_config/FW_config_campaign.yaml
export CAMPAIGN_PROJECT=fsi_pf6
# Fresh category for this machine's fireworks. MUST differ from any category that already holds
# fireworks in the same launchpad (the NERSC campaign used gpu4pyscf_fsi and gpu4pyscf_fsi_*).
export CAMPAIGN_CATEGORY=gpu4pyscf_fsi_kestrel
export CAMPAIGN_CALC_CONFIG=$CAMPAIGN_REPO/config/calc_config.yaml

# --- Slurm ---------------------------------------------------------------------------
export SBATCH_ACCOUNT=<allocation>        # sbatch --account
export GPU_PARTITION=gpu-h100             # Kestrel H100 partition
export GPUS_PER_NODE=4                    # Kestrel GPU nodes: 4x H100 80GB, 128 cores
export CPUS_PER_GPU=32
export CAMPAIGN_LAUNCH_ROOT=/scratch/$USER/gpu4pyscf_launches   # per-job launch dirs (.traj files, FW_job.out)
export CAMPAIGN_LOG_DIR=$CAMPAIGN_REPO/logs                      # Slurm stdout
